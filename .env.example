# Docker Compose configuration.

# Poltergeist's storage volume, so saves and level strings are reachable.
STORAGE_DATA_PATH=../poltergeist/volumes/storage

# The Docker network of the Poltergeist deployment.
POLTERGEIST_NETWORK=poltergeist_default

# A GitHub token that can read the private poltergeist-core repository.
GITHUB_TOKEN=
