# The public base URL of this server, without a trailing slash. Returned to the
# client by getAccountURL, so the client can find the backup and sync endpoints.
# The client appends /database/... to it.
APP_PUBLIC_URL=http://localhost

# The name shown to players in server messages.
APP_SERVER_NAME=Poltergeist

# Prefix that marks a level comment as a command (for example !rate 5).
APP_COMMAND_PREFIX=!

# Only clients at or above these versions are served. 22 is Geometry Dash 2.2;
# binary version 42 is 2.206.
APP_MIN_GAME_VERSION=22
APP_MIN_BINARY_VERSION=42

# Where the music and SFX libraries are downloaded from.
APP_CUSTOM_CONTENT_URL=https://geometrydashfiles.b-cdn.net

# Trust X-Forwarded-For when the server sits behind a reverse proxy.
APP_TRUST_PROXY_HEADERS=false

# Size limits in bytes.
APP_LEVEL_MAX_BYTES=8000000
APP_SAVE_MAX_BYTES=60000000

# Chest cooldowns in seconds.
APP_SMALL_CHEST_SECONDS=3600
APP_LARGE_CHEST_SECONDS=14400

# How long a verified login is cached in Redis before bcrypt is checked again.
APP_SESSION_SECONDS=3600

# Key for the JSON administration API. Leave empty to disable that API.
APP_ADMIN_API_KEY=

# The official servers, used to fetch Newgrounds song metadata on demand.
BOOMLINGS_URL=https://www.boomlings.com/database
BOOMLINGS_TIMEOUT_SECONDS=5

# MySQL pool size.
MYSQL_POOL_MIN=2
MYSQL_POOL_MAX=16
